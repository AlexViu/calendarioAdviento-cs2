<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AdventCalendar</AssemblyName>
    <RootNamespace>AdventCalendar</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lo aporta el propio CounterStrikeSharp en runtime: no se copia -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.375">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Va junto al plugin (cada plugin carga sus propias dependencias) -->
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Contrato compartido de cs2-store (shared/StoreApi): NO se copia -->
    <Reference Include="StoreApi">
      <HintPath>..\lib\StoreApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="StripHostAssemblies" AfterTargets="Build">
    <ItemGroup><_HostDll Include="$(OutDir)Microsoft.Extensions.*.dll" /></ItemGroup>
    <Delete Files="@(_HostDll)" />
  </Target>

</Project>
